{
  "name": "devhub",
  "version": "0.1.0",
  "description": "Le hub central du développeur moderne — CLI tout-en-un",
  "type": "module",
  "bin": {
    "devhub": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "devhub",
    "cli",
    "developer",
    "tools",
    "snippets",
    "productivity"
  ],
  "author": "cianneydev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cianneydev/devhub.git"
  },
  "bugs": {
    "url": "https://github.com/cianneydev/devhub/issues"
  },
  "homepage": "https://github.com/cianneydev/devhub#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "commander": "^12.0.0"
  }
}
